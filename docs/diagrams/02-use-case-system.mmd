  E2 --> REL
  E3 --> REL
  REL --> E10
  OTA --> P5
  P5 --> E12

  %% ---------------- server plane ----------------
  E9 --> V1
  E10 --> V1
  E7 --> V1
  E8 --> V1
  V1 --> V5
  V1 --> V7
  V2 --> V3
  V3 --> V4
