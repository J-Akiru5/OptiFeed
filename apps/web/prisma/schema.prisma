// Phase 0: Device state & command event model foundation.
// Single event log (DeviceStateEvent) is the source of truth for audit trail,
// notifications, and schedule sync. Three features are thin read/filter views.
//
// RLS is enabled via migration 20261013020000_enable_rls_on_user (User table);
// core indexes on Pond/Notification/FcrReport were added in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum PondStatus {
  ACTIVE
  ARCHIVED
}

enum CropCycleStatus {
  ACTIVE
  HARVESTED
  CANCELLED
}

enum PondEventType {
  STOCKING
  HARVEST_PLANNED
  HARVEST_ACTUAL
  SAMPLING
  MAINTENANCE
  OTHER
}

enum PondEventStatus {
  PLANNED
  DONE
  MISSED
  CANCELLED
}

enum PondOwnershipEventType {
  CREATED
  TRANSFERRED
}

model User {
  id                 String   @id @default(cuid())
  supabaseId         String   @unique // references Supabase Auth user.id
  farmId             String   @unique // login slug, e.g. "demo-farmer-1" — used as Pond.ownerId
  email              String   @unique
  displayName        String?
  role               UserRole @default(OPERATOR)
  mustChangePassword Boolean  @default(false)
  avatarPath         String? // object key in the private `avatars` bucket (#198); served via short-lived signed URLs
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  farm           Farm?               // exactly one farm per farmer (enforced by Farm.ownerId @unique)
  ponds          Pond[]
  settingsDrafts PondSettingsDraft[]

  @@index([farmId])
  @@index([role])
}

model Farm {
  id        String   @id @default(cuid())
  ownerId   String   @unique // exactly 1 farm per farmer → User.farmId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [farmId], onDelete: Cascade)
  ponds Pond[]

  @@index([ownerId])
}

model Pond {
  id                 String     @id @default(cuid())
  ownerId            String
  farmId             String
  name               String
  feedingRatePct     Float
  feedsPerDay        Int
  population         Int? // real fish count; null means not set, so no automatic feed calculation
  sampleIntervalDays Int        @default(14)
  scheduleStart      DateTime   @db.Time()
  scheduleEnd        DateTime   @db.Time()
  notificationPrefs  Json       @default("{\"missedFeeding\":true,\"deviceOffline\":true,\"hopperLow\":true,\"harvestReminders\":true,\"samplingReminders\":true,\"emailReminders\":true}")
  status             PondStatus @default(ACTIVE)
  isFallow           Boolean    @default(false) // harvest/cancel leaves the pond active but not feeding
  createdAt          DateTime   @default(now())

  owner            User?                  @relation(fields: [ownerId], references: [farmId], onDelete: Restrict)
  farm             Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  devices          Device[]
  biomassLogs      BiomassLog[]
  fcrReports       FcrReport[]
  notifications    Notification[]
  energyDevices    EnergyDevice[]
  scheduleCommands ScheduleCommand[]
  ownershipHistory PondOwnershipHistory[]
  cropCycles       CropCycle[]
  pondEvents       PondEvent[]
  settingsDrafts   PondSettingsDraft[]

  @@index([ownerId])
  @@index([farmId])
  @@index([status])
}

model CropCycle {
  id     String          @id @default(cuid())
  pondId String
  farmId String? // immutable ownership stamp
  label  String? // "Batch 2026-10"
  status CropCycleStatus @default(ACTIVE)

  stockingDate         DateTime @db.Date
  stockingCount        Int
  stockingAvgWeightG   Float?
  growOutDays          Int      @default(135)
  targetHarvestDate    DateTime @db.Date
  targetHarvestWeightG Float?
  expectedSurvivalPct  Float?

  actualHarvestDate     DateTime? @db.Date
  actualHarvestWeightKg Float?
  actualHarvestCount    Int?
  actualFcr             Float?

  notes     String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pond   Pond        @relation(fields: [pondId], references: [id], onDelete: Cascade)
  events PondEvent[]
  // One ACTIVE cycle per pond is enforced by a partial unique index in the
  // migration; Prisma cannot express partial indexes in the schema.

  @@index([pondId, status])
  @@index([farmId])
}

model PondEvent {
  id          String          @id @default(cuid())
  pondId      String
  cropCycleId String?
  farmId      String?
  type        PondEventType
  status      PondEventStatus @default(PLANNED)
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean         @default(true)
  notes       String?
  source      String? // "manual" | "cycle" | "device" | "sampling" | "feeding"
  sourceId    String? // device event id, if applicable
  createdBy   String
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Google-Calendar-style fields (issues #195/#196). Recurring items are one row,
  // expanded into occurrences when read; done occurrences are listed explicitly.
  kind                 PondItemKind    @default(EVENT)
  color                String? // "#RRGGBB"; null = colour of the event type
  recurrenceFreq       RecurrenceFreq?
  recurrenceInterval   Int             @default(1)
  recurrenceUntil      DateTime?
  completedOccurrences DateTime[]      @default([])
  reminderMinutes      Int[]           @default([]) // e.g. [60, 1440] = 1 h and 1 day before

  pond      Pond       @relation(fields: [pondId], references: [id], onDelete: Cascade)
  cropCycle CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  @@index([pondId, startsAt])
  @@index([farmId, startsAt])
  @@index([cropCycleId])
}

model ReminderLog {
  id          String   @id @default(cuid())
  pondId      String
  cropCycleId String?
  pondEventId String?
  kind        String // "harvest_d14" | "harvest_d7" | ... | "sampling_due"
  channel     String // "in_app" | "email"
  dedupeKey   String   @unique
  recipient   String?
  status      String   @default("SENT") // "SENT" | "FAILED"
  attempts    Int      @default(1)
  lastError   String?
  sentAt      DateTime @default(now())

  @@index([pondId, kind])
  @@index([cropCycleId])
}

model Device {
  // @deprecated — prefer EnergyDevice for all device interactions.
  // FeedingEvent and this model are no longer written (task 5.2; seeds were
  // the last writers). Kept until a later release drops the tables (H9).
  id             String    @id @default(cuid())
  pondId         String
  name           String
  connectivity   String
  isPaused       Boolean   @default(false)
  lastSyncedAt   DateTime?
  hopperLevelPct Float

  pond          Pond           @relation(fields: [pondId], references: [id])
  feedingEvents FeedingEvent[]
}

model BiomassLog {
  id             String   @id @default(cuid())
  pondId         String
  sampleWeightKg Float
  sampleLengthCm Float
  sampleCount    Int
  avgWeightKg    Float
  batchLabel     String? // optional free-text label shared by all fish in this log session
  source         String? // "form" | "import" | "seed"; null = legacy rows
  recordedAt     DateTime @default(now())
  farmId         String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  pond        Pond         @relation(fields: [pondId], references: [id])
  fishSamples FishSample[]

  @@index([pondId, recordedAt])
  @@index([farmId])
}

model FishSample {
  id           String  @id @default(cuid())
  biomassLogId String
  weightGrams  Float
  lengthCm     Float
  farmId       String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  biomassLog BiomassLog @relation(fields: [biomassLogId], references: [id], onDelete: Cascade)

  @@index([biomassLogId])
  @@index([farmId])
}

// @deprecated — use DeviceStateEvent + FeedEvent for new dispense tracking.
// Kept for seed data and existing chat intent system.
model FeedingEvent {
  id               String   @id @default(cuid())
  deviceId         String
  scheduledTime    DateTime
  dispensedVolumeG Float
  status           String
  createdAt        DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])
}

model FcrReport {
  id            String   @id @default(cuid())
  pondId        String
  periodStart   DateTime
  periodEnd     DateTime
  totalFeedKg   Float
  biomassGainKg Float
  fcrValue      Float
  farmId        String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  pond Pond @relation(fields: [pondId], references: [id])

  @@index([pondId, periodStart])
  @@index([pondId, periodEnd])
  @@index([farmId])
}

// Historical feed level readings for trend charts on /growth and /history.
// Mirrors the shape of BiomassLog. Logged sparingly to avoid bloat.
model FeedLevelLog {
  id           String       @id @default(cuid())
  deviceId     String
  device       EnergyDevice @relation(fields: [deviceId], references: [id])
  levelPercent Float
  distanceCm   Float
  recordedAt   DateTime     @default(now())
  farmId       String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  @@index([deviceId, recordedAt])
  @@index([farmId])
}

model Notification {
  id             String    @id @default(cuid())
  pondId         String
  tier           String
  message        String
  linkTo         String?
  read           Boolean   @default(false)
  category       String? // "connectivity" | "feeding" | "pellet" | "pge" | "schedule" | "system"
  acknowledgedAt DateTime?
  acknowledgedBy String?
  autoCleared    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  farmId         String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  pond Pond @relation(fields: [pondId], references: [id])

  @@index([pondId, read])
  @@index([farmId])
}

model EnergyDevice {
  id              String    @id @default(cuid())
  mac             String    @unique
  token           String    @unique // plaintext token — for display/provisioning only; never used for lookup
  tokenHash       String?   @unique // sha256(token) hex — all auth lookups go through this
  label           String
  pondId          String?
  rtcOk           Boolean   @default(true)
  feederActive    Boolean   @default(false)
  isPaused        Boolean   @default(false) // schedule pause state — replaces deprecated Device.isPaused
  gramsPerFeeding Float     @default(150)
  buttonFeedGrams Float     @default(80) // configurable button dose — pushed via poll response, no OTA needed
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())

  // Feed level monitoring (HC-SR04 ultrasonic)
  feedLevelPercent   Float? // 0-100, null until first reading arrives
  feedLevelCm        Float? // raw ultrasonic distance, kept for debugging/recalibration
  feedLevelUpdatedAt DateTime? // last time a reading was ingested

  // Water temperature (DS18B20 probe)
  waterTempC         Float? // last reading in °C, null until first reading arrives
  waterTempOk        Boolean   @default(false) // false if probe undetected on last heartbeat
  waterTempUpdatedAt DateTime? // last time a reading was ingested

  // Wi-Fi signal reported on the heartbeat (firmware 1.6.2+). Both stay null on
  // old firmware, which keeps the timing-only connectivity rule working.
  wifiRssiDbm       Int? // last RSSI in dBm (-127..0), null until reported
  wifiRssiUpdatedAt DateTime? // last time an RSSI was ingested

  // Per-device calibration
  hopperEmptyCm             Float? // sensor distance when hopper is empty (~30cm for 10L bottle)
  hopperFullCm              Float? // sensor distance when hopper is full (~5cm)
  hopperCapacityG           Float? // total hopper capacity in grams (e.g. 7000 for 10L)
  dailyCapG                 Int? // pond's daily feed ceiling; null → DEFAULT_DAILY_CAP_G (2000)
  gramsPerSecond            Float     @default(4.0) // motor dispense rate — pushed via poll response
  tempOffsetC               Float     @default(0) // DS18B20 calibration offset in °C
  lastCalibratedAt          DateTime? // last saved rate test or passing target check
  recalibrationIntervalDays Int       @default(30) // remind the operator to re-test after this many days

  // Org device-registration policy (issue #190): PENDING devices get no token until approved.
  approvalStatus DeviceApproval @default(APPROVED)

  pond             Pond?              @relation(fields: [pondId], references: [id])
  calibrationRuns  CalibrationRun[]
  feedEvents       FeedEvent[]
  feedRequests     FeedRequest[]
  stateEvents      DeviceStateEvent[]
  scheduleCommands ScheduleCommand[]
  feedLevelLogs    FeedLevelLog[]
  waterTempLogs    WaterTempLog[]
  settingsDrafts   PondSettingsDraft[]

  @@index([pondId])
}

model FeedEvent {
  id            String   @id @default(cuid())
  deviceId      String
  eventId       String?  @unique
  eventType     String // "heartbeat" | "feed_dispensed" | "schedule_acked"
  timestamp     String // device RTC time — may be "unknown" if RTC unavailable
  grams         Float?
  source        String? // "scheduled" | "dashboard" | "button"
  feedRequestId String?
  commandId     String? // links to ScheduleCommand id for schedule_acked events
  rtcOk         Boolean?
  feederActive  Boolean?
  receivedAt    DateTime @default(now()) // server receipt time
  farmId        String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  device EnergyDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, receivedAt])
  @@index([eventType, receivedAt])
  @@index([farmId])
}

model FeedRequest {
  id        String   @id @default(cuid())
  deviceId  String
  grams     Float    @default(100)
  status    String   @default("pending") // "pending" | "dispatched" | "completed" | "expired" | "fulfilled_by_other_trigger"
  kind      String   @default("feed") // "feed" | "calibration"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmId    String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  device EnergyDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@index([farmId])
}

// Unified event log — source of truth for audit trail, notifications, and schedule sync.
// Every device write becomes a queued command; every device read becomes a state event.
model DeviceStateEvent {
  id         String   @id @default(cuid())
  deviceId   String
  eventType  String // "connected" | "disconnected" | "command_sent" | "command_acked" | "command_failed" | "schedule_changed" | "schedule_applied" | "feed_dispensed" | "feed_reconciled" | "pge_reading" | "pellet_low" | "pellet_refilled" | "manual_trigger" | "notification_acknowledged" | "set_time" | "data_imported" | "data_exported" | "prediction_applied" | "token_revealed" | "config_applied"
  source     String // "system" | "user" | "device"
  actorId    String? // userId who triggered it (nullable for device-originated)
  metadata   Json? // flexible payload (old/new values, request IDs, error details)
  deviceTime String? // RTC timestamp from device — may be "unknown", null for user-originated events
  createdAt  DateTime @default(now())
  farmId     String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  device EnergyDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt])
  @@index([eventType, createdAt])
  @@index([farmId])
}

// Schedule edits as queued commands — never write directly to Pond.
// The Pond fields reflect the last applied command.
model ScheduleCommand {
  id              String    @id @default(cuid())
  deviceId        String
  pondId          String
  scheduleStart   DateTime  @db.Time()
  scheduleEnd     DateTime  @db.Time()
  feedsPerDay     Int
  feedingRatePct  Float
  buttonFeedGrams Float     @default(80)
  status          String    @default("pending") // "pending" | "sent" | "acked" | "applied" | "failed"
  createdBy       String? // userId
  appliedAt       DateTime? // server timestamp when device confirmed
  deviceTime      String? // RTC timestamp from device ack
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  farmId          String? // immutable ownership stamp — no FK by design (survives farm lifecycle)

  device EnergyDevice @relation(fields: [deviceId], references: [id])
  pond   Pond         @relation(fields: [pondId], references: [id])

  @@index([deviceId, status])
  @@index([deviceId, appliedAt])
  @@index([farmId])
}

// Immutable pond ownership history (EMS emu_installations analog).
// Rows are written by DB triggers on Pond insert / farmId change — never by
// app code. farmId is an immutable stamp with no FK (survives farm lifecycle).
model PondOwnershipHistory {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondId         String
  farmId         String // farm that owns the pond after this event
  previousFarmId String? // null on CREATED, previous farm on TRANSFERRED
  eventType      PondOwnershipEventType
  changedById    String? // actor slug — no FK (actor may be deleted); null: DB trigger has no actor context
  createdAt      DateTime               @default(now())

  pond Pond @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@index([pondId, createdAt])
  @@index([farmId])
}

// Per-farm brute-force lockout tracking.
// Supabase Auth has IP-level rate limits but no per-account lockout.
model UserLockout {
  // Global per-farm failure counter: >= 20 fails/hour slows the next login
  // and notifies the farm (security category), but NEVER locks the farmer out.
  farmId         String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("user_lockout")
}

// Per (farm, IP) hard lockout: 5 failed PIN attempts lock this pair for
// 15 minutes. Split by IP so a stranger hammering the login cannot lock
// the real farmer out of their own account.
model LoginLockout {
  farmId         String
  ip             String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(6)
  lastFailedAt   DateTime? @db.Timestamptz(6)

  @@id([farmId, ip])
  @@map("login_lockout")
}

/// Fixed-window rate-limit counters. Declared here so the Prisma schema matches
/// the table created by raw SQL in 20261013010000_add_rate_limiter_and_lockout;
/// otherwise every migration diff tries to drop it.
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_bucket")
}

enum OrgType {
  INDIVIDUAL
  COOPERATIVE
  COMPANY
  LGU
  ACADEMIC
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  PURGED
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model Organization {
  id                  String    @id @default(cuid())
  name                String
  type                OrgType   @default(INDIVIDUAL)
  status              OrgStatus @default(ACTIVE)
  parentId            String?
  suspendedAt         DateTime?
  suspendedReason     String?
  deletionRequestedAt DateTime?
  purgeAfter          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}

model Membership {
  id        String     @id @default(cuid())
  orgId     String
  userId    String
  role      MemberRole
  invitedBy String?
  createdAt DateTime   @default(now())
  revokedAt DateTime?

  @@unique([orgId, userId])
  @@index([userId])
}

model MembershipPermission {
  id           String    @id @default(cuid())
  membershipId String
  permission   String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([membershipId, permission])
}

model PlatformAdmin {
  id            String    @id @default(cuid())
  userId        String    @unique
  grantedBy     String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  mfaEnrolledAt DateTime?
  createdAt     DateTime  @default(now())
}

model PlatformAuditLog {
  id              String    @id @default(cuid())
  actorUserId     String
  action          String
  targetType      String
  targetId        String?
  orgId           String?
  reason          String
  stepUpAt        DateTime?
  temporaryGrant  Boolean   @default(false)
  impersonationId String?
  before          Json?
  after           Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
}

model ImpersonationSession {
  id          String    @id @default(cuid())
  actorUserId String
  orgId       String
  mode        String
  reason      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
}

/// Platform-global AI provider chain, managed from /superadmin.
/// Secrets are never stored here: apiKeyEnv names an environment variable that
/// holds the key, resolved at call time by lib/ai-providers/config.ts.
model AiProviderConfig {
  id        String   @id @default(cuid())
  /// Registry id from lib/ai-providers/registry.ts, e.g. "opencode-go".
  provider  String   @unique
  enabled   Boolean  @default(true)
  /// Lower runs first.
  priority  Int      @default(100)
  /// Provider-specific model id; null means the adapter default.
  model     String?
  /// Environment variable holding the key; null means the adapter default.
  apiKeyEnv String?
  /// Provider-specific extras (e.g. { "reasoningEffort": "high" }).
  params    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priority])
}

/// Durable queue for work that must not run inside the request path
/// (bulk CSV/ZIP exports, import confirmation). Claimed with
/// `FOR UPDATE SKIP LOCKED`, processed by the cron worker.
model BackgroundJob {
  id          String       @id @default(cuid())
  /// Tenant key (User.farmId). Never exposed across farms.
  ownerId     String
  /// Supabase user id of the requester, for audit.
  requestedBy String?
  /// "export_csv" | "export_zip" | "import_confirm"
  type        String
  /// "queued" | "running" | "succeeded" | "failed"
  status      String       @default("queued")
  payload     Json
  result      Json?
  error       String?
  attempts    Int          @default(0)
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  expiresAt   DateTime
  artifact    JobArtifact?

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([expiresAt])
}

/// Generated file for a finished export job. Bytes live in Postgres for now;
/// production can swap this for object storage without changing the API.
model JobArtifact {
  jobId       String        @id
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  job         BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum DeviceApproval {
  PENDING
  APPROVED
  REJECTED
}

enum DeviceRegistrationMode {
  ADMIN_APPROVAL
  SELF_REGISTER
}

enum CalibrationKind {
  RATE_TEST // timed run; measured grams give a new g/s
  TARGET_CHECK // dispense a target dose; the error corrects g/s
}

/// App-wide settings the superadmin edits (issue #187: list page size).
/// `value` is JSON so new keys need no migration; readers validate it.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Per-organization settings (issue #190). One row per org, created on first save;
/// readers fall back to these defaults when the row is missing.
model OrgSetting {
  orgId                 String                 @id
  defaultFeedingRatePct Float                  @default(3)
  hopperLowPct          Int                    @default(20)
  offlineAfterMin       Int                    @default(30) // deprecated (I-97): kept for compatibility; offline alerts follow PlatformSetting "device.status"
  missedFeedingAlerts   Boolean                @default(true)
  alertRoles            MemberRole[]           @default([OWNER, ADMIN])
  deviceRegistration    DeviceRegistrationMode @default(ADMIN_APPROVAL)
  updatedById           String?
  updatedAt             DateTime               @updatedAt
}

/// Every calibration attempt, kept as history (issue #191). Runs in one sitting share
/// `sessionId`; `attempt` counts the re-tests within it.
model CalibrationRun {
  id                   String          @id @default(cuid())
  deviceId             String
  sessionId            String
  attempt              Int
  kind                 CalibrationKind
  durationMs           Int?
  targetGrams          Float?
  measuredGrams        Float
  gramsPerSecondBefore Float
  gramsPerSecondAfter  Float?
  errorPct             Float?
  accepted             Boolean         @default(false)
  createdById          String?
  createdAt            DateTime        @default(now())
  device               EnergyDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([sessionId])
}

/// Water temperature history for the dashboard trend (issue #188), one row per
/// accepted DS18B20 reading, written by the ingest route next to FeedLevelLog.
model WaterTempLog {
  id         String       @id @default(cuid())
  deviceId   String
  tempC      Float
  recordedAt DateTime     @default(now())
  farmId     String? // immutable ownership stamp — no FK by design (survives farm lifecycle)
  device     EnergyDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@index([farmId])
}

enum PondItemKind {
  EVENT // has a time range
  TASK // has a due date and a done checkbox
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
}

enum AssistantActionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  FAILED
}

/// An action the AI assistant proposed and the user must Accept or Reject (issue #194).
/// The server stores the validated payload; Accept re-checks permissions and runs the
/// same server action a button would. Never executed without an explicit Accept.
model AssistantAction {
  id        String                @id @default(cuid())
  userId    String
  orgId     String?
  pondId    String?
  kind      String // e.g. "feeding.apply_grams", "records.log_sample", "admin.invite_member"
  payload   Json
  summary   String // human-readable description shown on the Accept card
  status    AssistantActionStatus @default(PENDING)
  result    Json?
  error     String?
  expiresAt DateTime
  decidedAt DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, status, createdAt])
}

enum ErrorSeverity {
  ERROR
  WARNING
  INFO
}

/// First-party error capture (mission 2026-10-29e, owner decision E1).
///
/// One row per distinct error, keyed by `fingerprint` (sha256 of severity,
/// scrubbed route, scrubbed message and the first stack frame). A repeat
/// occurrence increments `count` and moves `lastSeenAt`; it does not insert.
/// Recurrence reopens a resolved row, so a "fixed" error that comes back is
/// visible again.
///
/// `message`, `stack`, `route` and `context` are scrubbed before write by
/// lib/error-scrub.ts — no device token, bearer token, password, e-mail or
/// Supabase key may reach this table. Rows silent for
/// ERROR_EVENT_RETENTION_DAYS (30) are pruned by deleteExpiredErrorEvents()
/// from the device-watch cron, so the table cannot grow unbounded.
model ErrorEvent {
  id          String        @id @default(cuid())
  fingerprint String        @unique
  message     String
  stack       String?
  route       String
  severity    ErrorSeverity @default(ERROR)
  context     Json?
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  count       Int           @default(1)
  resolved    Boolean       @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([lastSeenAt])
  @@index([resolved, lastSeenAt])
}

/// Unsaved pond-settings form values, kept per (pond, user) so a reader can
/// leave the page (fix a conflicting device setting, close the browser) and
/// still find their typed values on return (I-99, #371).
///
/// `data` holds the form values only — never a secret, token or password. The
/// row is scoped to the editing user, so one member's draft can never surface
/// for another member of the same farm. `deviceId` records the pond's feeder at
/// save time (null when the pond has none) and is cleared if that feeder is
/// deleted. `deleteExpiredPondSettingsDrafts()` prunes rows after 30 days.
model PondSettingsDraft {
  id        String   @id @default(cuid())
  pondId    String
  userId    String
  deviceId  String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pond   Pond          @relation(fields: [pondId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device EnergyDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([pondId, userId])
  @@index([pondId])
  @@index([deviceId])
}
