{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/.vercel",
			"!**/dist",
			"!**/prisma/migrations",
			"!**/test-results",
			"!**/playwright-report",
			"!**/next-env.d.ts",
			"!**/*.md",
			"!**/*.mdx",
			"!**/*.html",
			"!**/*.htm",
			"!**/*.yml",
			"!**/*.yaml",
			"!**/*.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnsafeOptionalChaining": "off"
			},
			"a11y": {
				"noStaticElementInteractions": "off",
				"useAriaPropsSupportedByRole": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json"],
			"json": {
				"formatter": {
					"expand": "auto"
				}
			}
		}
	]
}
