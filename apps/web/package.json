{
	"name": "@optifeed/web",
	"version": "1.42.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && node scripts/migrate-if-production.mjs && next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"complexity": "node scripts/check-complexity.mjs",
		"i18n:tl-coverage": "node scripts/i18n-tagalog-coverage.mjs",
		"test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
		"seed:dev": "tsx prisma/seed-dev.ts",
		"seed:tenant-b": "tsx scripts/seed-tenant-b.ts",
		"manage-user": "tsx prisma/manage-users.ts",
		"platform-admin": "tsx scripts/platform-admin.ts"
	},
	"dependencies": {
		"@fullcalendar/react": "^7.1.3",
		"@prisma/client": "^7.10.1",
		"@react-three/drei": "10.7.9",
		"@react-three/fiber": "9.8.2",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.49.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"driver.js": "^1.8.0",
		"exceljs": "4.4.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"jszip": "^3.10.1",
		"lucide-react": "^1.23.0",
		"motion": "^14.6.0",
		"next": "16.4.2",
		"next-intl": "^4.1.0",
		"papaparse": "^5.6.0",
		"qrcode-generator": "2.0.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"recharts": "^3.10.1",
		"resend": "^6.34.1",
		"sonner": "^1.7.4",
		"tailwind-merge": "^3.6.0",
		"temporal-polyfill": "^1.0.6",
		"three": "0.186.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.186.0",
		"@vitest/coverage-v8": "4.1.12",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"prisma": "^6.6.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^4.1.12"
