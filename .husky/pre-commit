# Block accidental .env commits (defense-in-depth — .gitignore should catch these)
if git diff --cached --name-only | grep -qE '\.env$|\.env\.'; then
  echo "ERROR: Attempting to commit .env file. This is blocked by policy."
  echo "Remove it from staging with: git reset HEAD <file>"
  exit 1
fi

pnpm exec lint-staged
