# Database (Supabase PostgreSQL)
DATABASE_URL=

# Direct connection (bypasses connection pooler, needed for migrations)
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI chat + feeding prediction.
# The provider chain (order, model, enablement) is managed in /superadmin as
# AiProviderConfig; these variables only supply the keys it references.
# Defaults when no rows exist: OpenCode Go (primary), then Gemini (fallback).
OPENCODE_GO_API_KEY=
GEMINI_API_KEY=
# Optional overrides (defaults: deepseek-v4.1-flash, high)
OPENCODE_GO_MODEL=
OPENCODE_GO_REASONING_EFFORT=

# Canonical app origin (absolute links in alerts and exports)
NEXT_PUBLIC_BASE_URL=

# Public origin advertised by robots.txt, sitemap.xml and the Open Graph /
# Twitter metadata. Resolved at build time. Default when unset:
# https://pakaonai.syntaxure.dev — set it only for a deployment that must
# advertise a different host (container, preview, self-hosted).
NEXT_PUBLIC_SITE_URL=

# Demo account password (only used by the seed/e2e scripts)
DEMO_PASSWORD=

# Cron endpoint secret (api/cron/device-watch and api/cron/crop-watch) — also
# stored once in Supabase Vault by the matching docs/sql/cron-*.sql file (H10)
CRON_SECRET=

# Harvest/sampling reminder email (Resend). Email is skipped (in-app reminders
# still run) unless ALL THREE of RESEND_API_KEY, REMINDER_FROM_EMAIL and
# NEXT_PUBLIC_BASE_URL are set. REMINDER_FROM_EMAIL must be on a verified
# Resend sending domain, e.g. "OptiFeed <reminders@your-domain>".
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# Member invitation email (Resend). Sent to the email address the inviter
# types when a new login is provisioned. Skipped (the one-time password is
# still shown once to the inviter) unless RESEND_API_KEY, INVITE_FROM_EMAIL
# and NEXT_PUBLIC_BASE_URL are set. Must be on the verified syntaxure.dev
# domain. Default: PakaonAI <invite@syntaxure.dev>
INVITE_FROM_EMAIL="PakaonAI <invite@syntaxure.dev>"

# Telegram alerts for CRITICAL events (task 3.5) — alerts are DB-only
# (no-op on Telegram) until H11 creates the bot and sets these
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ESP32 device token (used by seed script)
DEVICE_TOKEN=

# E2E fixture (mission T-08). The suite runs against the production project
# while PakaonAI is not in operation, using an isolated e2e- fixture.
# E2E_ALLOWED_DB_HOST must exactly equal the DATABASE_URL hostname;
# E2E_CONFIRM_PRODUCTION must be the literal "yes"; E2E_PASSWORD is shared by
# the three e2e- logins and is required by the seed and Playwright.
# See docs/e2e-on-production.md for the integrator run order.
E2E_ALLOWED_DB_HOST=
E2E_CONFIRM_PRODUCTION=
E2E_PASSWORD=
