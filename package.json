{
	"name": "optifeed",
	"version": "1.31.4",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"build": "pnpm --filter web build",
		"dev": "pnpm --filter web dev",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"prisma:generate": "pnpm --filter web run prisma:generate",
		"prisma:migrate": "pnpm --filter web run prisma:migrate",
		"prepare": "husky",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter web test",
		"api:check": "node scripts/api/conformance-check.mjs",
		"api:live": "node scripts/api/live-check.mjs",
		"self-check": "node scripts/self-check.mjs",
		"audit:gate": "node scripts/security/audit-gate.mjs",
		"dead-code": "knip",
		"complexity": "pnpm --filter web complexity",
		"perf:bundle": "node scripts/perf/bundle-budget.mjs",
		"perf:latency": "node scripts/perf/api-latency.mjs",
		"perf:lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,md}": ["biome check --write --staged --no-errors-on-unmatched"]
	},
	"commitlint": {
		"extends": ["@commitlint/config-conventional"]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"husky": "^9.1.7",
		"knip": "6.43.0",
		"lint-staged": "^15.5.2"
	},
	"pnpm": {
		"overrides": {
			"baseline-browser-mapping": "^2.11.0",
			"browserslist": "^4.28.7",
			"dompurify": "^3.4.17",
			"proxy-addr": "^2.0.8",
			"source-map-js": "^1.2.2"
		}
	}
}
