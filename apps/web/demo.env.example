# Demo-only configuration. Copy to apps/web/.env (git-ignored) on the
# demo/system-online worktree. Never commit real Supabase keys here.

# Throwaway local database on the installed PostgreSQL service (port 5433)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/optifeed_demo?schema=public"
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/optifeed_demo?schema=public"

# Dummy auth project: demo mode never calls Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://demo.invalid"
NEXT_PUBLIC_SUPABASE_ANON_KEY="demo-anon-key"

# Demo auth bypass + seeded identity (must match prisma/seed-dev.ts)
DEMO_MODE="1"
DEMO_SUPABASE_ID="demo-supabase-user-001"
DEMO_EMAIL="demo-farmer-1@pond.optifeed.local"

# Heartbeat simulator
DEMO_DEVICE_MAC="DE:AD:DE:MO:00:01"
DEMO_DEVICE_TOKEN="demo-token-dev-only-001"
DEMO_BASE_URL="http://localhost:3000"

# Optional tuning
# DEMO_HEARTBEAT_MS="60000"
# DEMO_START_LEVEL="82"
