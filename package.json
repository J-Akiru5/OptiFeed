{
	"name": "optifeed",
	"version": "1.60.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"build": "pnpm --filter web build",
		"dev": "pnpm --filter web dev",
		"lint": "biome check --max-diagnostics=200 .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"prisma:generate": "pnpm --filter web run prisma:generate",
		"prisma:migrate": "pnpm --filter web run prisma:migrate",
		"postinstall": "node scripts/prisma-generate-if-present.mjs",
		"prepare": "husky",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter web test",
		"api:check": "node scripts/api/conformance-check.mjs && node scripts/api/auth-check.mjs",
		"api:live": "node scripts/api/live-check.mjs",
		"deploy:check": "node scripts/ops/deployment-policy.mjs",
		"migrations:check": "node scripts/ops/migration-ledger.mjs",
		"self-check": "node scripts/self-check.mjs",
		"audit:gate": "node scripts/security/audit-gate.mjs",
		"security:overrides": "node scripts/security/check-overrides.mjs",
		"security:tenant-proof": "node apps/web/scripts/security/tenant-isolation-proof.mjs",
		"ota:publish": "node scripts/ota/publish-release.mjs",
		"dead-code": "knip",
		"complexity": "pnpm --filter web complexity",
		"perf:bundle": "node scripts/perf/bundle-budget.mjs",
		"perf:latency": "node scripts/perf/api-latency.mjs",
		"perf:lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,md}": ["biome check --write --staged --no-errors-on-unmatched"]
	},
	"commitlint": {
		"extends": ["@commitlint/config-conventional"]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"husky": "^9.1.7",
		"knip": "6.44.1",
		"lint-staged": "^17.6.0"
	}
}
