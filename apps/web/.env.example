# Database (Supabase PostgreSQL)
DATABASE_URL=

# Direct connection (bypasses connection pooler, needed for migrations)
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI chat + feeding prediction (OpenCode Go — DeepSeek V4.1 Flash by default)
OPENCODE_GO_API_KEY=
# Optional overrides (defaults: deepseek-v4.1-flash, high)
OPENCODE_GO_MODEL=
OPENCODE_GO_REASONING_EFFORT=

# Canonical app origin (absolute links in alerts and exports)
NEXT_PUBLIC_BASE_URL=

# Demo account PIN (only used by the seed script)
DEMO_PIN=

# Cron endpoint secret (api/cron/device-watch) — also stored once in
# Supabase Vault by docs/sql/cron-device-watch.sql (H10)
CRON_SECRET=

# Telegram alerts for CRITICAL events (task 3.5) — alerts are DB-only
# (no-op on Telegram) until H11 creates the bot and sets these
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ESP32 device token (used by seed script)
DEVICE_TOKEN=

# E2E safety guard (task 4.4): Playwright refuses to run unless the
# DATABASE_URL host exactly matches this allow-listed host
E2E_ALLOWED_DB_HOST=
