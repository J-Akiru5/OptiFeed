# Database (Supabase PostgreSQL)
DATABASE_URL=

# Direct connection (bypasses connection pooler, needed for migrations)
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Chat (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Error tracking (Sentry) — H4 sets SENTRY_DSN in Vercel
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Canonical app origin (absolute links in alerts and exports)
NEXT_PUBLIC_BASE_URL=

# Demo account PIN (only used by the seed script)
DEMO_PIN=

# Cron endpoint secret (api/cron/device-watch) — also stored once in
# Supabase Vault by docs/sql/cron-device-watch.sql (H10)
CRON_SECRET=

# Telegram alerts for CRITICAL events (task 3.5) — alerts are DB-only
# (no-op on Telegram) until H11 creates the bot and sets these
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ESP32 device token (used by seed script)
DEVICE_TOKEN=

# Upstash Redis (used for rate limiting in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
